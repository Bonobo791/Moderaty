# On Netlify, set these under Site settings → Environment variables instead
# (see DEPLOY.md). APP_URL must be the deployed site URL there, since it is
# the base of the Google OAuth redirect. DRY_RUN=true previews enforcement
# (audit rows only, no YouTube writes); set it to false to act on YouTube.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:5173
# adapter-node (Coolify) only: the public origin behind the CDN — pins URL
# generation so the app never sees the internal fqdn (docs/COOLIFY_BUNNY.md).
ORIGIN=
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
OPENAI_API_KEY=
# Optional — model for prompt-injection screening before AI scoring.
OPENAI_JAILBREAK_MODEL=gpt-4.1-mini
# Optional — chat model for the per-channel tone pass (level 2 sensitivity).
OPENAI_TONE_MODEL=gpt-4.1-nano
CRON_SECRET=
ENCRYPTION_KEY=
DRY_RUN=true
# MailJet (transactional e-mail — the opt-in contact form's verification
# e-mails). API key (public) and secret key (private) from Mailjet →
# Account settings → REST API. MAILJET_FROM_EMAIL must be a sender verified
# in the Mailjet account (https://app.mailjet.com/account/sender).
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Moderaty
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Credit bundles (Stripe Price ids, mode-scoped: price_1... test with test
# keys, live with live keys). A bundle with an unset price is not offered.
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=
# Hosted access ($5/month, 100 comments per paid billing period).
STRIPE_PRICE_HOSTED_MONTHLY=
# Lifetime access ($49 one-time, capped at 1,000 active purchasers).
STRIPE_PRICE_LIFETIME=
# Operator smoke test (optional): a Stripe Product (prod_...) or Price
# (price_...) id. When set, a "Test checkout" card appears on the usage
# page — but ONLY for the operator account hardcoded in
# src/lib/server/billing/checkout.ts, never for other users — that runs a
# REAL purchase through the whole billing pipeline (checkout → webhook →
# ledger) and grants 1 credit. Use it to verify a deployment end-to-end,
# then remove it. Self-hosters: the operator gate is not configurable —
# change TEST_CHECKOUT_OPERATOR_EMAIL in the source if you need it.
STRIPE_TEST_PRODUCT=
# Mercado Pago BRL prepaid credit checkout (optional; leave unset to hide it)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_PRICE_CREDITS_100_BRL_CENTS=
MERCADOPAGO_PRICE_CREDITS_500_BRL_CENTS=
MERCADOPAGO_PRICE_CREDITS_2000_BRL_CENTS=
