{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "This config was generated using 'stryker init'. Please see the guide for more information: https://stryker-mutator.io/docs/stryker-js/guides/svelte",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/lib/server/testuser.ts",
    "!src/routes/terms/+page.ts",
    "!src/routes/privacy/+page.ts",
    "!src/routes/dpa/+page.ts"
  ],
  "testRunner": "vitest",
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ]
}
