{
	"name": "moderaty",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"scripts": {
		"db:migrate": "node scripts/db-migrate.mjs",
		"db:verify": "node scripts/verify-migrations.mjs",
		"dev": "vite dev",
		"dev:cron": "node --env-file=.env scripts/dev-cron.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/vitest-runner": "9.6.1",
		"@sveltejs/adapter-netlify": "6.0.4",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"dotenv-cli": "11.0.0",
		"drizzle-kit": "0.31.10",
		"fast-check": "4.9.0",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"typescript": "6.0.3",
		"vite": "8.2.0",
		"vitest": "5.0.1"
	},
	"dependencies": {
		"@libsql/client": "0.17.4",
		"@openai/guardrails": "0.2.1",
		"drizzle-orm": "0.45.2",
		"nodemailer": "10.0.10",
		"recheck": "4.5.0",
		"stripe": "22.5.0"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		},
		"typed-rest-client": {
			"qs": "^6.15.3"
		},
		"cookie": "0.7.0"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true
	}
}
