{
	"name": "moderaty",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"scripts": {
		"db:migrate": "drizzle-kit migrate",
		"db:verify": "node scripts/verify-migrations.mjs",
		"dev": "vite dev",
		"dev:cron": "node --env-file=.env scripts/dev-cron.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"drizzle-kit": "^0.31.10",
		"fast-check": "^4.9.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"drizzle-orm": "^0.45.2",
		"recheck": "4.5.0",
		"stripe": "22.5.0"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		},
		"typed-rest-client": {
			"qs": "^6.15.3"
		}
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true
	}
}
